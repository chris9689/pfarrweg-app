# ---- Vercel (Production / Preview) -------------------------------------------
# Supabase Postgres connection string. Use the "Transaction pooler" URL (port 6543).
# POSTGRES_URL (set by the Vercel ↔ Supabase integration) is used as a fallback.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional: separate connection for migrations during `vercel-build` (e.g. the "Session pooler" URL).
# MIGRATION_DATABASE_URL=

# Administrator password – set ONE of the following (mark it "Sensitive" in Vercel):
#   ADMIN_PASSWORD       plain password, at least 12 characters
#   ADMIN_PASSWORD_HASH  scrypt hash from: npm run hash-password -- "<password>"  (preferred)
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Building settings
BUILDING_NAME=Pfarrweg
BUILDING_TIMEZONE=Europe/Berlin

# ---- Local development only (`npm run dev`, in-memory database) --------------
# DEV_ADMIN_PASSWORD=choose-a-local-password
# DEV_APARTMENT_CODES=11111111,22222222,33333333,44444444
